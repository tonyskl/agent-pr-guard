{
  "name": "agent-pr-guard",
  "version": "0.1.0",
  "description": "Deterministic, local-first pull request risk analysis.",
  "keywords": [
    "pull-request",
    "cli",
    "ci",
    "security",
    "risk-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyskl/agent-pr-guard.git"
  },
  "bugs": {
    "url": "https://github.com/tonyskl/agent-pr-guard/issues"
  },
  "homepage": "https://github.com/tonyskl/agent-pr-guard#readme",
  "bin": {
    "agent-pr-guard": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "cli": "node dist/cli/index.js",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
